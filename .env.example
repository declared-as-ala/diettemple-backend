# ── MinIO Object Storage ──────────────────────────────────────────────────────
# In Docker: MINIO_ENDPOINT=minio (service name), MINIO_PORT=9000
# Local dev outside Docker: MINIO_ENDPOINT=localhost, MINIO_PORT=9000
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=diettemple
MINIO_SECRET_KEY=change-this-to-a-strong-secret

# ── Gemini vision (meal scan + gym scan)
# Keep the real key only in an ignored .env file or the deployment secret store.
GEMINI_API_KEY=
# Optional overrides
# GEMINI_MODEL=gemini-3.1-flash-lite
# GEMINI_TIMEOUT_MS=15000
# GEMINI_MAX_IMAGE_SIDE=1280
